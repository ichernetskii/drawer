  "version": "2.0.0",
  "tasks": [
    // add yarn run validate:ts
    {
      "label": "validate:ts",
      "type": "shell",
      "command": "yarn run validate:ts"
    },
    {
      "label": "eslint",
      "type": "shell",
      "command": "yarn run eslint"
    },
    {
      "label": "eslint:fix",
      "type": "shell",
      "command": "yarn run eslint:fix"
    },
    {
      "label": "prettier",
      "type": "shell",
      "command": "yarn run prettier"
    },
    {
      "label": "prettier:fix",
      "type": "shell",
      "command": "yarn run prettier:fix"
    }
  ]
}
