{
  "compilerOptions": {
    "target": "ES2016",
    "module": "ES2022",

    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@domain": ["src_clean_architecture/domain/index.ts"],
      "@domain/*": ["src_clean_architecture/domain/*"],
      "@use-cases": ["src_clean_architecture/use-cases/index.ts"],
      "@use-cases/*": ["src_clean_architecture/use-cases/*"],
      "@adapters": ["src_clean_architecture/adapters/index.ts"],
      "@adapters/*": ["src_clean_architecture/adapters/*"],
      "@infrastructure": ["src_clean_architecture/infrastructure/index.ts"],
      "@infrastructure/*": ["src_clean_architecture/infrastructure/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "src_clean_architecture", "vite.config.ts"]
}
