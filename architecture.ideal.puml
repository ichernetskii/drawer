@startuml Canvas Drawing Application - Ideal Architecture

!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTYELLOW #FFF9C4
!define LIGHTPINK #FCE4EC
!define LIGHTGRAY #F5F5F5
!define LIGHTCYAN #E0F7FA
!define LIGHTORANGE #FFE0B2

skinparam componentStyle rectangle
skinparam linetype ortho

' ====================
' PRESENTATION LAYER
' ====================
package "Presentation Layer" as presentation LIGHTBLUE {

    package "Controllers" {
        interface IController
        [MouseController] as mouse
        [KeyboardController] as keyboard
        [WheelController] as wheel
        [ToolbarController] as toolbar
        [TouchController] as touch <<new>>

        IController <|.. mouse
        IController <|.. keyboard
        IController <|.. wheel
        IController <|.. toolbar
        IController <|.. touch
    }

    [InputCoordinator] as inputCoordinator <<new>>

    package "Renderers" {
        interface IRenderer
        [SceneRenderer] as sceneRenderer
        [EntityRenderer] as entityRenderer

        IRenderer <|.. sceneRenderer
        IRenderer <|.. entityRenderer

        package "Drawable Renderers" {
            [DrawableRenderer] as drawableRenderer
            [RectangleRenderer] as rectRenderer
            [EllipseRenderer] as ellipseRenderer
            [TextRenderer] as textRenderer <<new>>
            [LineRenderer] as lineRenderer <<new>>

            IRenderer <|.. drawableRenderer
            IRenderer <|.. rectRenderer
            IRenderer <|.. ellipseRenderer
            IRenderer <|.. textRenderer
            IRenderer <|.. lineRenderer
        }

        package "Selection Renderers" {
            [SelectionRenderer] as selectionRenderer
            [SelectionBoxRenderer] as boxRenderer
            [SelectionPreviewRenderer] as previewRenderer
            [SelectionHoverRenderer] as hoverRenderer

            IRenderer <|.. selectionRenderer
            IRenderer <|.. boxRenderer
            IRenderer <|.. previewRenderer
            IRenderer <|.. hoverRenderer
        }

        [GridRenderer] as gridRenderer
        [DebugRenderer] as debugRenderer <<new>>

        IRenderer <|.. gridRenderer
        IRenderer <|.. debugRenderer
    }

    package "View Models" <<new>> {
        [CanvasViewModel] as canvasVM
        [ToolbarViewModel] as toolbarVM
    }
}

' ====================
' APPLICATION LAYER
' ====================
package "Application Layer" as application LIGHTGREEN {

    package "Use Cases" <<new>> {
        interface IUseCase

        [CreateDrawableUseCase] as createDrawable
        [UpdateDrawableUseCase] as updateDrawable
        [DeleteDrawableUseCase] as deleteDrawable
        [SelectDrawablesUseCase] as selectDrawables
        [MoveDrawablesUseCase] as moveDrawables
        [ResizeDrawablesUseCase] as resizeDrawables
        [CopyPasteDrawablesUseCase] as copyPaste
        [UndoRedoUseCase] as undoRedo
        [NavigateSceneUseCase] as navigateScene
        [ExportSceneUseCase] as exportScene <<new>>
        [ImportSceneUseCase] as importScene <<new>>

        IUseCase <|.. createDrawable
        IUseCase <|.. updateDrawable
        IUseCase <|.. deleteDrawable
        IUseCase <|.. selectDrawables
        IUseCase <|.. moveDrawables
        IUseCase <|.. resizeDrawables
        IUseCase <|.. copyPaste
        IUseCase <|.. undoRedo
        IUseCase <|.. navigateScene
        IUseCase <|.. exportScene
        IUseCase <|.. importScene
    }

    package "Operations" {
        note as opNote
          **Legacy Operations**
          To be migrated to Use Cases
        end note
    }

    package "Services" {
        interface IStorageService
        interface ISerializationService <<new>>
        interface ICoordinateService <<new>>
        interface IHitTestService <<new>>

        [StorageService] as storageService
        [SerializationService] as serializationService <<new>>
        [CoordinateTransformService] as coordService <<new>>
        [HitTestService] as hitTestService <<new>>

        IStorageService <|.. storageService
        ISerializationService <|.. serializationService
        ICoordinateService <|.. coordService
        IHitTestService <|.. hitTestService
    }

    package "Commands (Command Pattern)" <<new>> {
        interface ICommand
        [CreateCommand] as createCmd
        [MoveCommand] as moveCmd
        [ResizeCommand] as resizeCmd
        [DeleteCommand] as deleteCmd
        [ChangeColorCommand] as colorCmd
        [CommandInvoker] as cmdInvoker

        ICommand <|.. createCmd
        ICommand <|.. moveCmd
        ICommand <|.. resizeCmd
        ICommand <|.. deleteCmd
        ICommand <|.. colorCmd
    }
}

' ====================
' INFRASTRUCTURE LAYER
' ====================
package "Infrastructure Layer" as infrastructure LIGHTYELLOW {

    package "Factories" {
        interface IEntityFactory
        [EntityFactory] as entityFactory
        [makeObservableAuto] as makeObservable

        IEntityFactory <|.. entityFactory
    }

    package "Repositories" <<new>> {
        interface IDrawableRepository
        interface ISelectionRepository
        interface ISceneRepository

        [DrawableRepository] as drawableRepo
        [SelectionRepository] as selectionRepo
        [SceneRepository] as sceneRepo

        IDrawableRepository <|.. drawableRepo
        ISelectionRepository <|.. selectionRepo
        ISceneRepository <|.. sceneRepo
    }

    package "Persistence" {
        interface IStorageAdapter

        [LocalStorageAdapter] as localStorage
        [IndexedDBAdapter] as indexedDB <<new>>
        [CloudStorageAdapter] as cloudStorage <<new>>

        IStorageAdapter <|.. localStorage
        IStorageAdapter <|.. indexedDB
        IStorageAdapter <|.. cloudStorage
    }

    package "Serialization" {
        interface ISerializer
        [JSONSerializer] as jsonSerializer
        [DrawableSerialization] as drawableSerializer

        ISerializer <|.. jsonSerializer
        ISerializer <|.. drawableSerializer
    }

    package "Export/Import" <<new>> {
        interface IExporter
        interface IImporter

        [SVGExporter] as svgExporter
        [PNGExporter] as pngExporter
        [JSONExporter] as jsonExporter
        [JSONImporter] as jsonImporter

        IExporter <|.. svgExporter
        IExporter <|.. pngExporter
        IExporter <|.. jsonExporter
        IImporter <|.. jsonImporter
    }

    package "Clipboard" {
        interface IClipboardAdapter
        [ClipboardAdapter] as clipboard

        IClipboardAdapter <|.. clipboard
    }

    package "Validation" <<new>> {
        [EntityValidator] as validator
        [SchemaValidator] as schemaValidator
    }
}

' ====================
' DOMAIN LAYER
' ====================
package "Domain Layer" as domain LIGHTPINK {

    package "Entities" {
        [Entity] as entityBase
        [Drawable] as drawableBase

        package "Drawable Types" {
            [Rectangle] as rect
            [Ellipse] as ellipse
            [Text] as text <<new>>
            [Line] as line <<new>>
            [Polygon] as polygon <<new>>
        }

        package "Selection Types" {
            [Selection] as selectionBase
            [SelectionBox] as selBox
            [SelectionPreview] as selPreview
            [SelectionHover] as selHover
        }

        [Grid]
    }

    package "Value Objects" <<new>> {
        [Position] as positionVO
        [Size] as sizeVO
        [Color] as colorVO
        [Transform] as transformVO
        [Bounds] as boundsVO
    }

    package "Domain Services" <<new>> {
        [GeometryService] as geometryService
        [IntersectionService] as intersectionService
        [SnapService] as snapService
    }

    package "Domain Events" <<new>> {
        interface IDomainEvent
        [DrawableCreated] as drawableCreated
        [DrawableModified] as drawableModified
        [DrawableDeleted] as drawableDeleted
        [SelectionChanged] as selectionChanged

        IDomainEvent <|.. drawableCreated
        IDomainEvent <|.. drawableModified
        IDomainEvent <|.. drawableDeleted
        IDomainEvent <|.. selectionChanged
    }

    package "Specifications" <<new>> {
        interface ISpecification
        [IsInsideBoundsSpec] as boundsSpec
        [HasValidSizeSpec] as sizeSpec
        [OverlapsSpec] as overlapSpec

        ISpecification <|.. boundsSpec
        ISpecification <|.. sizeSpec
        ISpecification <|.. overlapSpec
    }
}

' ====================
' STORE LAYER (MobX State Management)
' ====================
package "Store Layer" as store LIGHTGRAY {
    [RootStore] as rootStore
    [DrawableStore] as drawableStore
    [SelectionStore] as selectionStore
    [SceneStore] as sceneStore
    [ClientStore] as clientStore
    [HistoryStore] as historyStore
    [UIStore] as uiStore <<new>>
    [SettingsStore] as settingsStore <<new>>
}

' ====================
' CROSS-CUTTING CONCERNS
' ====================
package "Cross-Cutting Concerns" <<new>> as crosscutting LIGHTORANGE {
    [Logger] as logger
    [ErrorHandler] as errorHandler
    [PerformanceMonitor] as perfMonitor
    [EventBus] as eventBus
    [Analytics] as analytics
}

' ====================
' SHARED
' ====================
package "Shared Utilities" {
    [debounce]
    [snap]
    [retinaFix]
    [exhaustiveCheck]
    [math] <<new>>
    [validators] <<new>>
}

' ====================================
' KEY RELATIONSHIPS - PRESENTATION
' ====================================

' Input Coordinator Pattern (new)
inputCoordinator --> mouse
inputCoordinator --> keyboard
inputCoordinator --> wheel
inputCoordinator --> toolbar
inputCoordinator --> touch

' Controllers -> Use Cases (instead of Operations)
inputCoordinator --> createDrawable
inputCoordinator --> selectDrawables
inputCoordinator --> moveDrawables
inputCoordinator --> resizeDrawables
inputCoordinator --> navigateScene
inputCoordinator --> copyPaste
inputCoordinator --> undoRedo

' View Models (MVVM pattern)
canvasVM --> rootStore
toolbarVM --> rootStore
sceneRenderer --> canvasVM
toolbar --> toolbarVM

' Renderers
sceneRenderer --> entityRenderer
entityRenderer --> drawableRenderer
entityRenderer --> selectionRenderer
entityRenderer --> gridRenderer
entityRenderer --> debugRenderer

drawableRenderer --> rectRenderer
drawableRenderer --> ellipseRenderer
drawableRenderer --> textRenderer
drawableRenderer --> lineRenderer

selectionRenderer --> boxRenderer
selectionRenderer --> previewRenderer
selectionRenderer --> hoverRenderer

' ====================================
' KEY RELATIONSHIPS - APPLICATION
' ====================================

' Use Cases -> Services
createDrawable --> drawableRepo
createDrawable --> entityFactory
createDrawable --> cmdInvoker
createDrawable --> eventBus

updateDrawable --> drawableRepo
updateDrawable --> cmdInvoker
updateDrawable --> eventBus

deleteDrawable --> drawableRepo
deleteDrawable --> cmdInvoker
deleteDrawable --> eventBus

selectDrawables --> selectionRepo
selectDrawables --> hitTestService
selectDrawables --> eventBus

moveDrawables --> drawableRepo
moveDrawables --> coordService
moveDrawables --> cmdInvoker

resizeDrawables --> drawableRepo
resizeDrawables --> cmdInvoker

copyPaste --> drawableRepo
copyPaste --> clipboard
copyPaste --> entityFactory

undoRedo --> cmdInvoker
undoRedo --> historyStore

navigateScene --> sceneRepo
navigateScene --> coordService

exportScene --> svgExporter
exportScene --> pngExporter
exportScene --> jsonExporter

importScene --> jsonImporter
importScene --> validator

' Command Pattern
cmdInvoker --> ICommand
cmdInvoker --> historyStore
createCmd ..> ICommand
moveCmd ..> ICommand
resizeCmd ..> ICommand
deleteCmd ..> ICommand
colorCmd ..> ICommand

' Services
storageService --> drawableRepo
storageService --> sceneRepo
storageService --> localStorage
storageService --> indexedDB
storageService --> cloudStorage

serializationService --> drawableSerializer
serializationService --> jsonSerializer

coordService --> geometryService
hitTestService --> intersectionService
hitTestService --> boundsSpec

' ====================================
' KEY RELATIONSHIPS - INFRASTRUCTURE
' ====================================

' Repositories -> Stores
drawableRepo --> drawableStore
selectionRepo --> selectionStore
sceneRepo --> sceneStore

' Repositories -> Factories
drawableRepo --> entityFactory

' EntityFactory -> Domain
entityFactory --> rect
entityFactory --> ellipse
entityFactory --> text
entityFactory --> line
entityFactory --> polygon
entityFactory --> selBox
entityFactory --> selPreview
entityFactory --> selHover
entityFactory --> Grid
entityFactory --> makeObservable

' Serialization
drawableSerializer --> entityFactory
drawableSerializer --> validator

' Export/Import
svgExporter --> drawableRepo
pngExporter --> sceneRenderer
jsonExporter --> serializationService
jsonImporter --> serializationService

' Validation
validator --> schemaValidator

' ====================================
' KEY RELATIONSHIPS - DOMAIN
' ====================================

' Entity Hierarchy
drawableBase --|> entityBase
rect --|> drawableBase
ellipse --|> drawableBase
text --|> drawableBase
line --|> drawableBase
polygon --|> drawableBase

selectionBase --|> entityBase
selBox --|> selectionBase
selPreview --|> selectionBase
selHover --|> selectionBase

Grid --|> entityBase

' Value Objects
entityBase --> positionVO
entityBase --> sizeVO
entityBase --> colorVO
drawableBase --> transformVO
selectionBase --> boundsVO

' Domain Services
geometryService --> positionVO
geometryService --> sizeVO
geometryService --> transformVO
intersectionService --> boundsVO
snapService --> positionVO

' Specifications
boundsSpec --> boundsVO
sizeSpec --> sizeVO
overlapSpec --> intersectionService

' ====================================
' KEY RELATIONSHIPS - STORE
' ====================================

rootStore *-- drawableStore
rootStore *-- selectionStore
rootStore *-- sceneStore
rootStore *-- clientStore
rootStore *-- historyStore
rootStore *-- uiStore
rootStore *-- settingsStore

drawableStore --> drawableBase
selectionStore --> selectionBase
sceneStore --> Grid
uiStore --> toolbarVM
settingsStore --> validator

' ====================================
' CROSS-CUTTING CONCERNS
' ====================================

logger ..> errorHandler
eventBus ..> logger
perfMonitor ..> analytics

' Event Bus (pub/sub)
createDrawable ..> eventBus
updateDrawable ..> eventBus
deleteDrawable ..> eventBus
eventBus ..> logger
eventBus ..> analytics

' Error Handling
inputCoordinator ..> errorHandler
sceneRenderer ..> errorHandler
storageService ..> errorHandler

' ====================================
' NOTES
' ====================================

note top of presentation
  **Improvements:**
  - Input Coordinator for centralized input
  - MVVM with View Models
  - Touch support for mobile
  - Interface-based controllers
  - Debug renderer for development
end note

note top of application
  **Improvements:**
  - Use Cases replace Operations
  - Command Pattern for undo/redo
  - Rich service layer
  - Export/Import capabilities
  - Event-driven architecture
end note

note top of infrastructure
  **Improvements:**
  - Repository Pattern
  - Multiple storage adapters
  - Export to SVG/PNG
  - Validation layer
  - Interface-based design
end note

note top of domain
  **Improvements:**
  - Value Objects for type safety
  - Domain Services for complex logic
  - Domain Events for loose coupling
  - Specifications for queries
  - More drawable types
end note

note top of crosscutting
  **New Cross-Cutting Concerns:**
  - Centralized logging
  - Error handling strategy
  - Performance monitoring
  - Event bus for pub/sub
  - Analytics integration
end note

note bottom of store
  **Improvements:**
  - UI Store for view state
  - Settings Store for preferences
  - Better separation of concerns
end note

legend right
  **Architecture Improvements:**

  **Design Patterns Added:**
  - Repository Pattern (data access)
  - Command Pattern (undo/redo)
  - MVVM (view logic separation)
  - Event Bus (pub/sub)
  - Specification Pattern (queries)
  - Factory interfaces

  **SOLID Principles:**
  - Interface Segregation
  - Dependency Inversion
  - Single Responsibility

  **New Features:**
  - Touch support
  - Multiple storage backends
  - Export to SVG/PNG
  - Import/Export JSON
  - Domain events
  - Validation layer
  - Debug tools
  - Analytics

  **Better Testability:**
  - Interfaces for mocking
  - Use Cases (single responsibility)
  - Dependency Injection ready
  - Domain logic isolation
end legend

@enduml
